[gd_resource type="Resource" script_class="CrawlUpgradeDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://resources/UpgradeDefinition.gd" id="script"]
[ext_resource type="Resource" path="res://data/classes/mage.tres" id="class"]
[ext_resource type="Resource" path="res://data/skills/combust.tres" id="skill"]
[ext_resource type="Script" path="res://resources/TacticRule.gd" id="tactic_type"]

[sub_resource type="Resource" id="default_tactic"]
script = ExtResource("tactic_type")
id = "unlocked:combust"
metric = "enemy_group_count"
comparator = "at_least"
threshold = 1.0
skill_id = "combust"
selector = "lowest_hp"

[resource]
script = ExtResource("script")
kind = "skill"
class_definition = ExtResource("class")
skill = ExtResource("skill")
cost = 200
default_tactic = SubResource("default_tactic")
